# Volunteer API settings (see docs/volunteer-api.md). None are required: the prototype values
# hardcoded in backend/volunteers/config.js (PROTOTYPE) are used for anything left unset.
# On Vercel, set these under Project -> Settings -> Environment Variables, then redeploy.

# Your own 32+ random characters, replacing the public prototype secret. Never change it once live.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Your own password for POST /api/v1/admin/login (prototype default: newbi-admin-2026)
ADMIN_API_KEY=

# Upstash Redis REST credentials (Vercel -> Storage -> Upstash for Redis sets these).
# Needed for the hosted site: Vercel runs several copies of the API and Redis is what they share.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Local SQLite database (default data/newbi.sqlite; off on Vercel unless set)
SQLITE_FILE=

# Twilio, for real OTP texts. Setting these turns OTP dev mode off.
# Indian SMS needs a DLT-registered sender and template.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# true/false forces OTP dev mode (code shown on screen instead of texted). Default: on until Twilio is set.
OTP_DEV_MODE=

# false removes the demo account (99999 99999 / 123456) and the demo events and volunteers
DEMO_MODE=

# Allowed browser origin for the API (default *)
CORS_ORIGIN=
