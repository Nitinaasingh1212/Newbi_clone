# Volunteer API settings (see docs/volunteer-api.md). Nothing is required for local runs.
# On Vercel, set these under Project -> Settings -> Environment Variables.

# 32+ random characters. Signs login tokens and keys the OTP/Aadhaar hashes. Never change it once live.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Password for POST /api/v1/admin/login (local default: dev-admin-key)
ADMIN_API_KEY=

# Upstash Redis REST credentials (Vercel Marketplace -> Upstash for Redis sets these).
# Without them data goes to data/volunteer-db.json locally, or /tmp on Vercel (not kept).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Twilio, for sending OTP texts. Indian SMS needs a DLT-registered sender and template.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# true = return the OTP in the API response instead of texting it. Testing only.
OTP_DEV_MODE=

# Allowed browser origin for the API (default *)
CORS_ORIGIN=
