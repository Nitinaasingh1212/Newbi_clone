{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "site",
  "trailingSlash": false,
  "functions": {
    "api/forms.js": {
      "includeFiles": "site/api/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1?__path=:path*"
    },
    {
      "source": "/((?!api/|assets/|brand/|og/).*)",
      "destination": "/concertzone/index.html"
    }
  ]
}
