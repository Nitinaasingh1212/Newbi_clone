{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "site",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1?__path=:path*"
    },
    {
      "source": "/events/:id",
      "destination": "/events/event.html"
    }
  ]
}
