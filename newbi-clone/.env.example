# ==========================================
# NEWBI.LIVE RECREATION - ENVIRONMENT CONFIG
# ==========================================

# Frontend Environment Variables (Vite)
VITE_API_URL=http://localhost:5000/api

# Backend Environment Variables (Node.js & Express)
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/newbi_live
JWT_SECRET=newbi_super_secure_jwt_secret_token_2026

# Optional Cloudinary Storage (if image uploads are enabled)
CLOUDINARY_CLOUD_NAME=demo_newbi
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
